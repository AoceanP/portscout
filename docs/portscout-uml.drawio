op=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="st"><mxGeometry y="106" width="220" height="8" as="geometry"/></mxCell><mxCell id="e0" value="uses" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="main" target="pp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="uses" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="main" target="tp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="uses" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="main" target="sc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="uses" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="main" target="rp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="calls, one virtual thread per probe" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sc" target="pr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="creates" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pr" target="sr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="formats" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rp" target="sr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1286" y="610"/><mxPoint x="1054" y="610"/></Array></mxGeometry></mxCell><mxCell id="e7" value="state 1" style="endArrow=open;endSize=12;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;startArrow=diamondThin;startFill=0;startSize=14;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sr" target="st"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;br&gt;&amp;bull; Every class except ScanResult is a final static utility with a private constructor.&lt;br&gt;&amp;bull; Data flows one way: Main &amp;rarr; parsers &amp;rarr; Scanner &amp;rarr; PortProbe &amp;rarr; ScanResult &amp;rarr; Report.&lt;br&gt;&amp;bull; Scanner uses java.util.concurrent: a virtual-thread executor capped by a Semaphore.&lt;br&gt;&amp;bull; PortProbe uses java.net.Socket for a TCP connect scan (no raw sockets, no admin rights).&lt;br&gt;&amp;bull; ScanResult is immutable, so threads can create results without locking." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="560" height="140" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;dashed open arrow = dependency (uses / creates)&lt;br&gt;diamond = ScanResult holds one State&lt;br&gt;+ public &amp;nbsp; - private &amp;nbsp; ~ package-private" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="360" height="90" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;portscout&lt;/b&gt; &amp;mdash; UML class diagram (package portscout)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="380" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
