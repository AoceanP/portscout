width="220" height="60" as="geometry"/></mxCell><mxCell id="sort" value="Sort results by host&lt;br&gt;(as a number), then port" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="910" width="220" height="60" as="geometry"/></mxCell><mxCell id="json" value="--json?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="280" y="1000" width="200" height="90" as="geometry"/></mxCell><mxCell id="ptab" value="&lt;b&gt;Report.table&lt;/b&gt;&lt;br&gt;open ports + summary" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="100" y="1130" width="220" height="60" as="geometry"/></mxCell><mxCell id="pjson" value="&lt;b&gt;Report.json&lt;/b&gt;&lt;br&gt;every result" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="440" y="1130" width="220" height="60" as="geometry"/></mxCell><mxCell id="end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="1240" width="140" height="50" as="geometry"/></mxCell><mxCell id="acq" value="Acquire a semaphore permit&lt;br&gt;(waits if the cap is reached)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="985" y="620" width="250" height="60" as="geometry"/></mxCell><mxCell id="conn" value="&lt;b&gt;PortProbe.probe&lt;/b&gt;&lt;br&gt;Socket.connect(host:port, timeout)&lt;br&gt;sends SYN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="985" y="710" width="250" height="70" as="geometry"/></mxCell><mxCell 