<mxfile host="app.diagrams.net"><diagram id="portscout-flow" name="Program flow"><mxGraphModel dx="1300" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g_main" value="Main thread" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="760" height="1310" as="geometry"/></mxCell><mxCell id="g_task" value="One probe task (own virtual thread, up to maxConcurrent at once)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="770" y="590" width="750" height="800" as="geometry"/></mxCell><mxCell id="start" value="Start&lt;br&gt;&lt;i&gt;portscout &amp;lt;target&amp;gt; [options]&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="20" width="220" height="60" as="geometry"/></mxCell><mxCell id="help" value="No args or&lt;br&gt;-h / --help?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="200" height="90" as="geometry"/></mxCell><mxCell id="usage" value="Print usage" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="545" y="130" width="170" height="50" as="geometry"/></mxCell><mxCell id="opts" value="&lt;b&gt;Main&lt;/b&gt;: read options&lt;br&gt;(-p, -t, -c, --json, --all)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex=